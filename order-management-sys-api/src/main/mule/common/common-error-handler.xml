<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" 
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <error-handler name="Common_Error_Handler" doc:id="06ef2ca4-3eca-4e76-8134-f1ab38d4885d">

        <!-- 400 - Bad Request / Invalid Input -->

        <!-- 401 - Unauthorized (Client ID Enforcement) -->

        <!-- 403 - Forbidden (Policy Failure) -->

        <!-- 404 - SKU / Resource Not Found -->
        <on-error-propagate type="APIKIT:NOT_FOUND"
                            enableNotifications="true" logException="true">
            <logger level="ERROR" doc:name="Logger" doc:id="e938bd29-fe9c-4a16-8caa-a3c4f3ddbe49" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    errorCode: 404,&#10;    message: "SKU was not found.",&#10;    correlationId: correlationId,&#10;    timestamp: now()&#10;}]'/>
			<ee:transform doc:name="404 SKU not found">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    errorCode: 404,
    message: "SKU was not found.",
    correlationId: correlationId,
    timestamp: now()
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus"><![CDATA[404]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <!-- 405 - Method Not Allowed -->
        <on-error-propagate type="APIKIT:NOT_IMPLEMENTED"
                            enableNotifications="true" logException="true">
            <logger level="ERROR" doc:name="Logger" doc:id="d928d750-f764-46e6-8a58-94b8ad4c33da" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    errorCode: 501,&#10;    message: "Method is calling unmapped routes.",&#10;    correlationId: correlationId,&#10;    timestamp: now()&#10;}]' />
			<ee:transform doc:name="501 Method not implemented">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    errorCode: 501,
    message: "Method is calling unmapped routes.",
    correlationId: correlationId,
    timestamp: now()
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus"><![CDATA[501]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <!-- 406 - Not Acceptable -->

        <!-- 415 - Unsupported Media Type -->
        <!-- [STUDIO:"On Error Propagate"]<on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE"
                            enableNotifications="true" logException="true">
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
&#45;&#45;-
{
    errorCode: 415,
    message: "Unsupported media type. Please use application/json.",
    correlationId: correlationId,
    timestamp: now()
}&#93;&#93;></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus"><![CDATA[415&#93;&#93;></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate> [STUDIO] -->

        <!-- 500 - DB Connectivity Error -->
        <on-error-propagate type="DB:CONNECTIVITY"
                            enableNotifications="true" logException="true">
            <logger level="ERROR" doc:name="Logger" doc:id="f11580a8-2d07-46b0-b4b1-d32309c75d04" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    errorCode: 500,&#10;    message: "Unable to connect to the database. Please try again later.",&#10;    correlationId: correlationId,&#10;    timestamp: now()&#10;}]' />
			<ee:transform doc:name="500 Database Connectivity error">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    errorCode: 500,
    message: "Unable to connect to the database. Please try again later.",
    correlationId: correlationId,
    timestamp: now()
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus"><![CDATA[500]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <!-- 500 - DB Query Error -->
        <on-error-propagate type="DB:QUERY_EXECUTION,DB:BAD_SQL_SYNTAX"
                            enableNotifications="true" logException="true">
            <logger level="ERROR" doc:name="Logger" doc:id="096b8960-61ab-4edc-9c5c-10cf283a9e2d" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    errorCode: 500,&#10;    message: "A database error occurred while processing your request.",&#10;    correlationId: correlationId,&#10;    timestamp: now()&#10;}]' />
			<ee:transform doc:name="500 Database Error">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    errorCode: 500,
    message: "A database error occurred while processing your request.",
    correlationId: correlationId,
    timestamp: now()
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus"><![CDATA[500]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

        <!-- 500 - Internal Server Error (catch-all) -->
        <on-error-propagate type="ANY"
                            enableNotifications="true" logException="true">
            <logger level="ERROR" doc:name="Logger" doc:id="6fcf14a9-246f-4a11-b6ae-b2552baabd8e" message='#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;    errorCode: 500,&#10;    message: "An unexpected error occurred. Please contact support.",&#10;    correlationId: correlationId,&#10;    timestamp: now()&#10;}]' />
			<ee:transform doc:name="500 Internal error">
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    errorCode: 500,
    message: "An unexpected error occurred. Please contact support.",
    correlationId: correlationId,
    timestamp: now()
}]]></ee:set-payload>
                </ee:message>
                <ee:variables>
                    <ee:set-variable variableName="httpStatus"><![CDATA[500]]></ee:set-variable>
                </ee:variables>
            </ee:transform>
        </on-error-propagate>

    </error-handler>
</mule>